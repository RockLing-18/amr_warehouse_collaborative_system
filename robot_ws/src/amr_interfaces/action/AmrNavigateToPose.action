# AmrNavigateToPose
# amr_manager -> amr_navigation 单点导航 Action（按坐标导航，纯能力接口）
# 状态常量见 amr_interfaces/msg/NavigationState.msg

# ===== Goal =====

geometry_msgs/PoseStamped goal_pose

---

# ===== Result =====

bool success
string message

---

# ===== Feedback =====

amr_interfaces/NavigationState state
geometry_msgs/PoseStamped current_pose
builtin_interfaces/Duration navigation_time              # 已导航时长
builtin_interfaces/Duration estimated_time_remaining     # 预计剩余时间
float32 distance_remaining
uint16 number_of_recoveries                          # 恢复行为触发次数
