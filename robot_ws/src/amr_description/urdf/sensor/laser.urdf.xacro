<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find amr_description)/urdf/common_inertia.xacro"/>
    <xacro:macro name="laser_xacro" params="radius length xyz prefix">
        <link name="${prefix}laser_cylinder_link">
            <visual>
                <geometry>
                    <cylinder radius="0.01" length="0.1"/>
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.0 0.0 0.5"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.01" length="0.1"/>
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.0 0.0 0.5"/>
                </material>
            </collision>
            <xacro:cylinder_inertia m="${0.1}" r="0.01" h="0.1"/>
        </link>
        <joint name="${prefix}claser_cylinder_joint" type="fixed">
            <parent link="${prefix}base_link"/>
            <child link="${prefix}laser_cylinder_link"/>
            <origin xyz="${xyz}"/>
        </joint> 
        <link name="${prefix}laser_link">
            <visual>
                <geometry>
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <material name="green">
                    <color rgba="0.0 1.0 0.0 0.8"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <material name="green">
                    <color rgba="0.0 1.0 0.0 0.8"/>
                </material>
            </collision>
            <xacro:cylinder_inertia m="${0.2}" r="${radius}" h="${length}"/>
        </link>
        <joint name="${prefix}laser_joint" type="fixed">
            <parent link="${prefix}laser_cylinder_link"/>
            <child link="${prefix}laser_link"/>
            <origin xyz="0 0 0.05"/>
        </joint>
        <gazebo reference="${prefix}laser_cylinder_link">
            <material>Gazebo/Black</material>
        </gazebo> 
        <gazebo reference="${prefix}laser_link">
            <material>Gazebo/Black</material>
        </gazebo>   
    </xacro:macro> 
</robot>
